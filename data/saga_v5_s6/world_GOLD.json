  {
   "id": "S01",
   "text": "that the old abbey at Coldhaven hides a second cellar"
  },
  {
   "id": "S02",
   "text": "that the Stenick mill ledger was rewritten after the flood"
  },
  {
   "id": "S03",
   "text": "that the fire at the Kelwick granary was set on purpose"
  },
  {
   "id": "S04",
   "text": "that the harbor master of Coldhaven takes bribes"
  },
  {
   "id": "S05",
   "text": "that a chest of silver lies buried beneath the well at Harrowton"
  },
  {
   "id": "S06",
   "text": "that the bridge toll at Coldhaven is skimmed every month"
  },
